{
  "name": "@barkever/app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "test": "node --test --experimental-strip-types src/*/*.test.ts scripts/*.test.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "j10": "playwright test -c e2e/j10/playwright.config.ts",
    "chaos": "node --experimental-strip-types --no-warnings src/chaos/cli.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
