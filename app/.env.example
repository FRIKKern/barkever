# Copy to app/.env.local (git-ignored). Server-only: none of these reach the browser.
# Left unset, `vite dev`/`vite preview` take URL and token from the bp CLI login (~/.config/barkpark/config.json).

# Barkpark server, no trailing slash.
BARKPARK_URL=https://guerrilla.barkpark.cloud
# Barkpark workspace that holds the note and notebook types.
BARKPARK_WORKSPACE=barkever
# Dataset to read: fixtures (50 synthetic notes) for dev and tests; production is real notes.
BARKPARK_DATASET=fixtures
# Your own Barkpark token. Never commit, print or paste it anywhere.
BARKPARK_TOKEN=
