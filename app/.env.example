# Copy to app/.env.local (git-ignored). Server-only: none of these reach the browser.
# Left unset, `vite dev`/`vite preview` take the Barkpark URL from the bp CLI login (~/.config/barkpark/config.json).

# Barkpark server, no trailing slash.
BARKPARK_URL=https://guerrilla.barkpark.cloud
# Barkpark workspace that holds the note and notebook types.
BARKPARK_WORKSPACE=barkever
# Dataset to read: fixtures (50 synthetic notes) for dev and tests; production is real notes.
BARKPARK_DATASET=fixtures

# Seals the sign-in cookie. 32+ random characters (openssl rand -base64 32). Unset: sign-ins end on restart.
BARKEVER_SESSION_SECRET=
# 1 = `vite dev` skips sign-in and acts as BARKPARK_TOKEN (or the bp CLI token). Ignored in a build.
BARKEVER_SHARED_TOKEN=
BARKPARK_TOKEN=

# e2e signs in as this Barkpark account (a member of workspace barkever). Never commit, print or paste them.
BARKEVER_E2E_EMAIL=
BARKEVER_E2E_PASSWORD=
