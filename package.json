{
  "name": "barkever",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-repo.mjs",
    "fixtures": "node fixtures/build.mjs",
    "seed": "node fixtures/build.mjs && node scripts/seed-fixtures.mjs",
    "scan": "node scripts/scan-outgoing.mjs",
    "dev": "pnpm --filter @barkever/app dev",
    "build": "pnpm -r build",
    "test": "node --test scripts/check-repo.test.mjs && pnpm -r test",
    "e2e": "pnpm --filter @barkever/app e2e",
    "prepush": "node scripts/check-repo.mjs && pnpm -r build && node --test scripts/check-repo.test.mjs && pnpm -r test && pnpm --filter @barkever/app e2e && node scripts/scan-outgoing.mjs"
  }
}
