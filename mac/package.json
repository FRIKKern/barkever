{
  "name": "@barkever/mac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "productName": "Barkever",
  "main": "src/main.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter @barkever/app build && electron .",
    "build": "tsc --noEmit",
    "test": "node ../scripts/own-tmp.mjs node --require ./test/fake/parent-watch.cjs --test --test-timeout=300000 --experimental-strip-types src/*.test.ts scripts/*.test.mjs e2e/*.test.ts",
    "e2e": "pnpm --filter @barkever/app build && node ../scripts/own-tmp.mjs playwright test -c e2e/playwright.config.ts",
    "dist": "node scripts/build.mjs",
    "rehearse": "node scripts/rehearse.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.276",
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  }
}
